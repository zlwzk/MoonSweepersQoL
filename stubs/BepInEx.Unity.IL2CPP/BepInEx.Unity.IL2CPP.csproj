<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>BepInEx.Unity.IL2CPP</AssemblyName>
    <RootNamespace>BepInEx</RootNamespace>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <FileVersion>6.0.0.0</FileVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>false</SignAssembly>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>MSB3277;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real BepInEx.Core (metadata is intact) provides Logging/Configuration/BasePlugin types. -->
    <Reference Include="BepInEx.Core">
      <HintPath>..\..\refs\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
